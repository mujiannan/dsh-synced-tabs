{
  "name": "dsh-synced-tabs",
  "version": "0.4.0",
  "type": "module",
  "description": "Cross-device session tabs for the DeepSeek Harness (DSH) Web GUI: one shared set of open sessions across every device, with a phone-first bottom bar and drawer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "README.md",
    "COMPATIBILITY.md",
    "LICENSE",
    "README.en.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "prepublishOnly": "node --test 'test/*.test.mjs'"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.0-rc.2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mujiannan/dsh-synced-tabs.git"
  },
  "homepage": "https://github.com/mujiannan/dsh-synced-tabs#readme",
  "bugs": {
    "url": "https://github.com/mujiannan/dsh-synced-tabs/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "tabs",
    "session-tabs",
    "cross-device",
    "web-ui"
  ]
}